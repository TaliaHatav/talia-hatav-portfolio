---
import { siteConfig } from '@config/site';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section class="intro">
  <header class="intro-header">
    <div class="header-left">
      <a href="#info">Info</a>
    </div>
    <div class="header-center">
      <a href="/" class="logo">{siteConfig.name}</a>
    </div>
    <div class="header-right">
      <a href="#contact">Book a Call</a>
    </div>
  </header>

  <div class="intro-tagline">
    <p>{siteConfig.bio}</p>
  </div>

  <div class="projects-grid">
    {projects.map((project) => (
      <a href={project.data.externalUrl || `/projects/${project.id}`} target={project.data.externalUrl ? '_blank' : undefined} class="project-card">
        <div class="project-image">
          <Image src={project.data.cover} alt={project.data.title} width={900} height={570} />
        </div>
        <div class="project-info">
          <h3>{project.data.title}</h3>
          {project.data.location && <p class="project-location">{project.data.location}</p>}
          <p class="project-year">{project.data.date.getFullYear()}</p>
        </div>
      </a>
    ))}
  </div>

  <footer class="intro-footer">
    <div class="footer-left">
      <a href="https://twitter.com" target="_blank" rel="noopener">@talia</a>
    </div>
    <div class="footer-right">
      <a href="#work">Open for Work</a>
    </div>
  </footer>
</section>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 4px 4rem 4rem 4rem;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  .intro-header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    margin-bottom: 12rem;
    gap: 2rem;
    margin-top: 2rem;
  }

  .header-left,
  .header-right {
    display: flex;
    justify-content: flex-start;
  }

  .header-right {
    justify-content: flex-end;
  }

  .header-center {
    display: flex;
    justify-content: center;
  }

  .intro-header a {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.3s, border-color 0.3s;
    padding: 8px 12px;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
  }

  .intro-header a:hover {
    opacity: 1;
    border-color: #0b5aff;
  }

  .logo {
    font-size: 1.25rem !important;
    font-weight: 600 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    opacity: 1 !important;
    border: none !important;
    padding: 0 !important;
  }

  .intro-tagline {
    text-align: center;
    margin-bottom: 8rem;
    padding: 0 2rem;
    margin-top: 2rem;
  }

  .intro-tagline p {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5rem;
    flex: 1;
    margin-bottom: 4rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s ease;
  }

  .project-card:hover {
    opacity: 0.75;
  }

  .project-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: 2rem;
    background: #f5f5f5;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-info h3 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .project-info p {
    margin: 0.5rem 0;
    opacity: 0.7;
    font-size: 0.95rem;
  }

  .project-year {
    font-weight: 500;
    opacity: 0.6;
  }

  .intro-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-left,
  .footer-right {
    display: flex;
  }

  .footer-right {
    justify-content: flex-end;
  }

  .intro-footer a {
    font-size: 0.875rem;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.3s;
  }

  .intro-footer a:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .intro {
      padding: 1.5rem 1rem;
    }

    .intro-header {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .header-left,
    .header-right,
    .header-center {
      justify-content: center;
    }

    .intro-tagline {
      margin-bottom: 4rem;
      padding: 0 1rem;
    }

    .projects-grid {
      gap: 3rem;
      margin-bottom: 2rem;
    }

    .intro-footer {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;
    }

    .footer-right {
      justify-content: center;
    }
  }
</style>

